<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Configurations>Release;Debug;Mystical;Kenko;Whoever2;ToUnity</Configurations>
    <ProfilePluginsDirectory Condition="'$(ProfilePluginsDirectory)' == '' And ('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' Or '$(Configuration)' == 'Kenko')">F:\WebfishingMods\RiskOfRain2\profiles\testing\BepInEx\plugins\fortunesteam-FortunesFromTheScrapyard</ProfilePluginsDirectory>
    <ProfilePluginsDirectory Condition="'$(ProfilePluginsDirectory)' == '' And '$(Configuration)' == 'Mystical'">B:\gale-profiles\riskofrain2\profiles\FortunesFromTheGraveyard\BepInEx\plugins\fortunesteam-FortunesFromTheScrapyard</ProfilePluginsDirectory>
    <ProfilePluginsDirectory Condition="'$(ProfilePluginsDirectory)' == '' And '$(Configuration)' == 'Whoever2'">targetpluginspath\fortunesteam-FortunesFromTheScrapyard</ProfilePluginsDirectory>
    <DisableFastUpToDateCheck Condition="'$(ProfilePluginsDirectory)' != ''">true</DisableFastUpToDateCheck>
    <ThumbsgupSource>$(MSBuildProjectDirectory)\..\FortunesUnityProject\Assets\FFTSAssets\Survivors\thumbsgup.png</ThumbsgupSource>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Compile Remove="Content\InDev\Survivors\Wrecker\**" />
    <EmbeddedResource Remove="Content\InDev\Survivors\Wrecker\**" />
    <None Remove="Content\InDev\Survivors\Wrecker\**" />
    <Compile Remove="Content\InDev\Monsters\**" />
    <EmbeddedResource Remove="Content\InDev\Monsters\**" />
    <None Remove="Content\InDev\Monsters\**" />
    <Compile Remove="Content\InDev\Items\Polypore\**" />
    <EmbeddedResource Remove="Content\InDev\Items\Polypore\**" />
    <None Remove="Content\InDev\Items\Polypore\**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Whoever2|AnyCPU'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Kenko|AnyCPU'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Mystical|AnyCPU'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ToUnity|AnyCPU'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Content\InDev\Elites\**" />
    <EmbeddedResource Remove="Content\InDev\Elites\**" />
    <None Remove="Content\InDev\Elites\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".gitignore" />
    <None Remove="nuget.config" />
    <None Include="$(ThumbsgupSource)" Link="thumbsgup.png" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
	<ItemGroup>
		<Reference Include="ShaderSwapper">
			<HintPath>..\libs\ShaderSwapper.dll</HintPath>
		</Reference>
		<Reference Include="MSU">
			<HintPath>..\libs\MSU.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="RiskOfOptions">
			<HintPath>..\FortunesUnityProject\Packages\Risk_Of_Options\plugins\RiskOfOptions\RiskOfOptions.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="CustomEmotesAPI">
			<HintPath>..\libs\CustomEmotesAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		
		
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="R2API" Version="5.0.5" />
		<PackageReference Include="R2API.Addressables" Version="1.1.3" />
		<PackageReference Include="R2API.Animations" Version="1.2.5" />
		<PackageReference Include="R2API.Elites" Version="1.1.3" />
		<PackageReference Include="R2API.Execute" Version="1.1.3" />
		<PackageReference Include="R2API.Items" Version="1.0.8" />
		<PackageReference Include="R2API.Skills" Version="1.0.6" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
		<PackageReference Include="R2API.Prefab" Version="1.*" />
		<PackageReference Include="R2API.RecalculateStats" Version="1.6.6" />
		<PackageReference Include="R2API.Sound" Version="1.*" />
		<PackageReference Include="R2API.ProcType" Version="1.*" />
	</ItemGroup>
  <Target Name="RequireThumbsgup" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ThumbsgupSource)')" Text="thumbsgup.png is load-bearing. Restore '$(ThumbsgupSource)' before building the mod." />
  </Target>
  <Target Name="WeaveNetworkAssembly" DependsOnTargets="ResolveReferences" Condition="'$(Configuration)' != 'ToUnity'">
    <PropertyGroup>
      <_WeaverDirectory Condition="'$(_WeaverDirectory)' == ''">$(MSBuildProjectDirectory)\Weaver</_WeaverDirectory>
      <_WeaverIntermediateDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Weaver'))</_WeaverIntermediateDirectory>
      <_WeaverInputDirectory>$(_WeaverIntermediateDirectory)\Input</_WeaverInputDirectory>
      <_WeaverReferencesDirectory>$(_WeaverIntermediateDirectory)\References</_WeaverReferencesDirectory>
      <_WeaverOutputDirectory>$(_WeaverIntermediateDirectory)\Patched</_WeaverOutputDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WeaverDirectory)\Unity.UNetWeaver.exe')" Text="Network Weaver was not found at '$(_WeaverDirectory)\Unity.UNetWeaver.exe'." />
    <MakeDir Directories="$(_WeaverInputDirectory);$(_WeaverReferencesDirectory);$(_WeaverOutputDirectory)" />
    <Copy SourceFiles="@(ReferencePath)" DestinationFolder="$(_WeaverReferencesDirectory)" SkipUnchangedFiles="true" />
    <Delete Files="$(_WeaverInputDirectory)\$(TargetName).pdb;$(_WeaverInputDirectory)\$(TargetFileName).mdb;$(_WeaverOutputDirectory)\$(TargetFileName);$(_WeaverOutputDirectory)\$(TargetName).pdb;$(_WeaverOutputDirectory)\$(TargetFileName).mdb" />
    <ItemGroup>
      <_WeaverInput Include="$(TargetPath)" />
      <_WeaverInput Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <_WeaverInput Include="$(TargetPath).mdb" Condition="Exists('$(TargetPath).mdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WeaverInput)" DestinationFolder="$(_WeaverInputDirectory)" />
    <Exec Command="&quot;$(_WeaverDirectory)\Unity.UNetWeaver.exe&quot; &quot;$(_WeaverReferencesDirectory)\UnityEngine.CoreModule.dll&quot; &quot;$(_WeaverReferencesDirectory)\com.unity.multiplayer-hlapi.Runtime.dll&quot; &quot;$(_WeaverOutputDirectory)&quot; &quot;$(_WeaverInputDirectory)\$(TargetFileName)&quot; &quot;$(_WeaverReferencesDirectory)&quot;" WorkingDirectory="$(_WeaverIntermediateDirectory)" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_WeaverConsoleOutput" />
    </Exec>
    <ItemGroup>
      <_WeaverSuccess Include="@(_WeaverConsoleOutput)" Condition="'%(_WeaverConsoleOutput.Identity)' == 'successfull'" />
    </ItemGroup>
    <Error Condition="'@(_WeaverSuccess)' == ''" Text="Network Weaver failed. See its output above; no plugin files were deployed." />
  </Target>
  <Target Name="StagePluginBuild" BeforeTargets="PostBuild" DependsOnTargets="WeaveNetworkAssembly">
    <PropertyGroup>
      <_BuildPluginsDirectory Condition="'$(_BuildPluginsDirectory)' == ''">$(MSBuildProjectDirectory)\..\Build\plugins</_BuildPluginsDirectory>
      <_SoundBankSource>$(MSBuildProjectDirectory)\..\FortunesUnityProject\Assets\StreamingAssets\aa\FFTSSoundBank.bnk</_SoundBankSource>
      <_StagedSoundBank>$(_BuildPluginsDirectory)\Soundbanks\FFTSSoundBank.bnk</_StagedSoundBank>
      <_AssemblyToStage>$(TargetPath)</_AssemblyToStage>
      <_AssemblyToStage Condition="'$(Configuration)' != 'ToUnity' And Exists('$(_WeaverOutputDirectory)\$(TargetFileName)')">$(_WeaverOutputDirectory)\$(TargetFileName)</_AssemblyToStage>
    </PropertyGroup>
    <ItemGroup>
      <_PluginAssembly Include="$(_AssemblyToStage)" />
      <_ObsoleteSymbols Include="$(TargetName).pdb;$(TargetFileName).mdb" />
      <_AssetBundles Include="$(MSBuildProjectDirectory)\..\FortunesUnityProject\AssetBundles\StandaloneWindows\*" Exclude="$(MSBuildProjectDirectory)\..\FortunesUnityProject\AssetBundles\StandaloneWindows\StandaloneWindows;$(MSBuildProjectDirectory)\..\FortunesUnityProject\AssetBundles\StandaloneWindows\StandaloneWindows.manifest" />
    </ItemGroup>
    <Error Condition="!Exists('$(_SoundBankSource)') And !Exists('$(_StagedSoundBank)')" Text="FFTSSoundBank.bnk was not found in Unity StreamingAssets or Build\plugins\Soundbanks. Generate the Wwise soundbank before deploying the mod." />
    <Warning Condition="!Exists('$(_SoundBankSource)')" Text="No newly generated FFTSSoundBank.bnk was found in Unity StreamingAssets. Deploying the existing staged soundbank from '$(_StagedSoundBank)'." />
    <Warning Condition="'@(_AssetBundles)' == ''" Text="No exported Unity asset bundles were found in FortunesUnityProject\AssetBundles\StandaloneWindows. Build the bundles in Unity before running or deploying the mod; existing staged bundles will not be updated." />
    <Delete Files="@(_ObsoleteSymbols->'$(_BuildPluginsDirectory)\%(Identity)')" />
    <Copy SourceFiles="@(_PluginAssembly)" DestinationFolder="$(_BuildPluginsDirectory)" />
    <Copy SourceFiles="$(ThumbsgupSource)" DestinationFolder="$(_BuildPluginsDirectory)" />
    <Copy SourceFiles="$(_SoundBankSource)" DestinationFiles="$(_StagedSoundBank)" Condition="Exists('$(_SoundBankSource)')" />
    <Copy SourceFiles="@(_AssetBundles)" DestinationFolder="$(_BuildPluginsDirectory)\AssetBundles" />
  </Target>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup Condition="'$(ProfilePluginsDirectory)' != ''">
      <_ProfilePluginFiles Include="$(_BuildPluginsDirectory)\**\*" />
    </ItemGroup>
    <Delete Files="@(_ObsoleteSymbols->'$(ProfilePluginsDirectory)\%(Identity)')" Condition="'$(ProfilePluginsDirectory)' != ''" />
    <Copy SourceFiles="@(_ProfilePluginFiles)" DestinationFiles="@(_ProfilePluginFiles->'$(ProfilePluginsDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'$(ProfilePluginsDirectory)' != ''" />
    <Message Importance="high" Text="Deployed $(TargetFileName) and plugin assets to '$(ProfilePluginsDirectory)'." Condition="'$(ProfilePluginsDirectory)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\FortunesUnityProject\Packages\FortunesFromTheScrapyard" Condition="'$(Configuration)' == 'ToUnity'" />
    <Copy SourceFiles="$(ThumbsgupSource)" DestinationFolder="$(MSBuildProjectDirectory)\..\FortunesUnityProject\Packages\FortunesFromTheScrapyard" Condition="'$(Configuration)' == 'ToUnity'" />
  </Target>
	<Target Name="ChangeAliasesOfStrongNameAssemblies" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
		<ItemGroup>
			<ReferencePath Condition="'%(FileName)' == 'Rewired_CSharp'">
				<Aliases>Rewired_CSharp_NS</Aliases>
			</ReferencePath>

			<ReferencePath Condition="'%(FileName)' == 'Rewired_Core'">
				<Aliases>Rewired_Core_NS</Aliases>
			</ReferencePath>
		</ItemGroup>
	</Target>
</Project>
